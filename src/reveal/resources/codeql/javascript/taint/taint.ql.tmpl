import javascript
import semmle.javascript.security.dataflow.RemoteFlowSources

predicate isTargetCall(
  API::CallNode call,
  string targetApi,
  string filePath,
  int line,
  int column
) {
  (
    {{TARGET_CLAUSES}}
  ) and
  call.getLocation().getFile().getRelativePath() = filePath and
  call.getLocation().getStartLine() = line and
  call.getLocation().getStartColumn() = column
}

module RemoteInputConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
  }

  predicate isSink(DataFlow::Node sink) {
    exists(
      API::CallNode call,
      string targetApi,
      string filePath,
      int line,
      int column,
      int argumentIndex
    |
      isTargetCall(
        call,
        targetApi,
        filePath,
        line,
        column
      ) and
      sink = call.getArgument(argumentIndex)
    )
  }
}

module RemoteInputFlow = TaintTracking::Global<RemoteInputConfig>;

from
  DataFlow::Node source,
  DataFlow::Node sink,
  API::CallNode call,
  string targetApi,
  string filePath,
  int line,
  int column,
  int argumentIndex
where
  isTargetCall(
    call,
    targetApi,
    filePath,
    line,
    column
  ) and
  sink = call.getArgument(argumentIndex) and
  (
    RemoteInputFlow::flow(source, sink) or
    source = sink
  )
select
  targetApi,
  source.getFile().getRelativePath(),
  source.getStartLine(),
  source.toString(),
  call.getLocation().getFile().getRelativePath(),
  call.getLocation().getStartLine(),
  call.toString(),
  argumentIndex
